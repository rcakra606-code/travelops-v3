{
  "tables": {
    "travelops_hotels": {
      "id": "VARCHAR(50) PRIMARY KEY",
      "hotel_name": "VARCHAR(255)",
      "guest_list": "TEXT",
      "check_in": "DATE",
      "check_out": "DATE",
      "room_type": "VARCHAR(100)",
      "region": "VARCHAR(100)",
      "status": "VARCHAR(50) DEFAULT 'Upcoming'",
      "confirmation_number": "VARCHAR(100)",
      "supplier_code": "VARCHAR(100)",
      "supplier_name": "VARCHAR(255)",
      "staff": "VARCHAR(255)",
      "created_at": "TIMESTAMP WITH TIME ZONE DEFAULT NOW()"
    },
    "travelops_tours": {
      "id": "VARCHAR(50) PRIMARY KEY",
      "country": "VARCHAR(255)",
      "category": "VARCHAR(50)",
      "departure_date": "DATE",
      "return_date": "DATE",
      "max_capacity": "INTEGER",
      "status": "VARCHAR(50) DEFAULT 'Pending'",
      "financials": "JSONB",
      "pax_info": "JSONB",
      "internals": "JSONB",
      "created_at": "TIMESTAMP WITH TIME ZONE DEFAULT NOW()"
    },
    "travelops_cruises": {
      "id": "VARCHAR(50) PRIMARY KEY",
      "cruise_brand": "VARCHAR(255)",
      "ship_name": "VARCHAR(255)",
      "pic_name": "VARCHAR(255)",
      "route": "VARCHAR(255)",
      "pax_count": "INTEGER",
      "sailing_start": "DATE",
      "sailing_end": "DATE",
      "cruise_line": "VARCHAR(255)",
      "booking_ref": "VARCHAR(100)",
      "final_payment_date": "DATE",
      "staff": "VARCHAR(255)",
      "participants": "JSONB",
      "phone_number": "VARCHAR(50)",
      "email": "VARCHAR(255)",
      "status": "VARCHAR(50) DEFAULT 'Upcoming'",
      "created_at": "TIMESTAMP WITH TIME ZONE DEFAULT NOW()"
    },
    "travelops_documents": {
      "id": "VARCHAR(50) PRIMARY KEY",
      "doc_type": "VARCHAR(50)",
      "guest_name": "VARCHAR(255)",
      "country": "VARCHAR(100)",
      "receive_date": "DATE",
      "estimated_done": "DATE",
      "send_date": "DATE",
      "price": "DECIMAL",
      "supplier": "VARCHAR(255)",
      "process_type": "VARCHAR(50)",
      "booking_code": "VARCHAR(100)",
      "invoice_number": "VARCHAR(100)",
      "phone_number": "VARCHAR(50)",
      "staff": "VARCHAR(255)",
      "tour_code": "VARCHAR(100)",
      "notes": "TEXT",
      "shipping_status": "VARCHAR(50) DEFAULT 'Processing'",
      "shipping_method": "VARCHAR(50)",
      "shipping_courier": "VARCHAR(100)",
      "shipping_resi": "VARCHAR(100)",
      "shipping_notes": "TEXT",
      "received_status": "VARCHAR(50)",
      "created_at": "TIMESTAMP WITH TIME ZONE DEFAULT NOW()"
    },
    "travelops_telecoms": {
      "id": "VARCHAR(50) PRIMARY KEY",
      "type": "VARCHAR(50)",
      "nama": "VARCHAR(255)",
      "region": "VARCHAR(100)",
      "no_telp": "VARCHAR(50)",
      "tanggal_mulai": "DATE",
      "tanggal_selesai": "DATE",
      "jumlah_deposit": "DECIMAL",
      "metode_deposit": "VARCHAR(100)",
      "no_rekening": "VARCHAR(100)",
      "bank": "VARCHAR(100)",
      "nama_rekening": "VARCHAR(255)",
      "estimasi_pengambilan": "DATE",
      "staff": "VARCHAR(255)",
      "deposit_status": "VARCHAR(50)",
      "tanggal_pengambilan": "DATE",
      "tanggal_pengembalian": "DATE",
      "created_at": "TIMESTAMP WITH TIME ZONE DEFAULT NOW()"
    },
    "travelops_cashouts": {
      "id": "VARCHAR(50) PRIMARY KEY",
      "staff_name": "VARCHAR(255)",
      "division": "VARCHAR(100)",
      "total_amount": "DECIMAL",
      "request_date": "DATE",
      "status": "VARCHAR(50) DEFAULT 'Pending'",
      "needs_approval": "BOOLEAN DEFAULT true",
      "request_items": "JSONB",
      "approved_by": "VARCHAR(255)",
      "approve_date": "TIMESTAMP WITH TIME ZONE",
      "created_at": "TIMESTAMP WITH TIME ZONE DEFAULT NOW()"
    },
    "travelops_sales_targets": {
      "id": "VARCHAR(50) PRIMARY KEY",
      "staff_name": "VARCHAR(255)",
      "target_sales": "DECIMAL",
      "target_profit": "DECIMAL",
      "achievement_sales": "DECIMAL",
      "achievement_profit": "DECIMAL",
      "period": "VARCHAR(50)",
      "created_at": "TIMESTAMP WITH TIME ZONE DEFAULT NOW()"
    },
    "travelops_reservation_audits": {
      "id": "VARCHAR(50) PRIMARY KEY",
      "type": "VARCHAR(50)",
      "request_text": "TEXT",
      "booking_text": "TEXT",
      "match_score": "INTEGER",
      "mismatches": "JSONB",
      "summary": "TEXT",
      "staff_name": "VARCHAR(255)",
      "created_at": "TIMESTAMP WITH TIME ZONE DEFAULT NOW()"
    },
    "user_sessions": {
      "id": "VARCHAR(255) PRIMARY KEY",
      "user_id": "VARCHAR(255)",
      "session_token": "TEXT",
      "device": "VARCHAR(255)",
      "os": "VARCHAR(255)",
      "browser": "VARCHAR(255)",
      "ip": "VARCHAR(100)",
      "location": "VARCHAR(255)",
      "last_active": "TIMESTAMP WITH TIME ZONE DEFAULT NOW()",
      "created_at": "TIMESTAMP WITH TIME ZONE DEFAULT NOW()"
    },
    "travelops_dest_countries": {
      "id": "VARCHAR(50) PRIMARY KEY",
      "name": "VARCHAR(255)",
      "region": "VARCHAR(100)",
      "currency": "JSONB",
      "emergency": "JSONB",
      "power_plugs": "JSONB",
      "visa_info": "JSONB",
      "customs_etiquette": "JSONB",
      "water_safety": "VARCHAR(100)",
      "created_at": "TIMESTAMP WITH TIME ZONE DEFAULT NOW()"
    },
    "travelops_dest_cities": {
      "id": "VARCHAR(50) PRIMARY KEY",
      "country_id": "VARCHAR(50)",
      "name": "VARCHAR(255)",
      "airports": "JSONB",
      "best_months": "JSONB",
      "transport_apps": "JSONB",
      "food_highlights": "JSONB",
      "hospital_contacts": "JSONB",
      "created_at": "TIMESTAMP WITH TIME ZONE DEFAULT NOW()"
    },
    "travelops_dest_objects": {
      "id": "VARCHAR(50) PRIMARY KEY",
      "city_id": "VARCHAR(50)",
      "country_id": "VARCHAR(50)",
      "name": "VARCHAR(255)",
      "category": "VARCHAR(100)",
      "est_duration_minutes": "INTEGER DEFAULT 90",
      "opening_hours": "JSONB",
      "ticket_policy": "JSONB",
      "dress_code": "TEXT",
      "rules": "JSONB",
      "guide_briefing_notes": "JSONB",
      "photo_spots": "JSONB",
      "cover_image_url": "TEXT",
      "created_at": "TIMESTAMP WITH TIME ZONE DEFAULT NOW()"
    },
    "travelops_tour_routes": {
      "id": "VARCHAR(100) PRIMARY KEY",
      "title": "VARCHAR(255)",
      "route_signature": "VARCHAR(255)",
      "country_id": "VARCHAR(50)",
      "country_name": "VARCHAR(255)",
      "duration_days": "INTEGER DEFAULT 7",
      "duration_nights": "INTEGER DEFAULT 6",
      "cities_sequence": "JSONB",
      "day_itinerary": "JSONB",
      "route_highlights": "JSONB",
      "theme_category": "VARCHAR(100) DEFAULT 'Leisure'",
      "transport_modes": "JSONB",
      "usage_count": "INTEGER DEFAULT 1",
      "created_at": "TIMESTAMP WITH TIME ZONE DEFAULT NOW()",
      "updated_at": "TIMESTAMP WITH TIME ZONE DEFAULT NOW()"
    }
  }
}
