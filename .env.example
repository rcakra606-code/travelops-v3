# ==============================================================================
# TravelOps V4 — Environment Variables Reference
# Copy to `.env` for local development or configure in Railway Variables.
# ==============================================================================

# --- Core Supabase & PostgreSQL ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Google Gemini AI (Copilot, OCR, BI Analyst, pgvector Embeddings) ---
GEMINI_API_KEY=your-gemini-api-key

# --- Sentry Observability ---
VITE_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Transactional Email (Option A: Resend HTTP API [Recommended]) ---
RESEND_API_KEY=
RESEND_FROM="TravelOps System <noreply@yourdomain.com>"

# --- Transactional Email (Option B: Pooled SMTP Fallback) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=TravelOps System

# --- Distributed Cache & Persistent Rate Limiting (Optional: Upstash Redis) ---
# When omitted, server automatically falls back to bounded in-memory LRU TTL cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Server-Side Daily Reminders Cron & Runtime ---
APP_URL=https://your-app.up.railway.app
APP_TIMEZONE=Asia/Jakarta
CRON_SECRET=generate-a-strong-random-secret
REMINDER_RECIPIENT_EMAIL=
LOG_LEVEL=info
PORT=3000
